{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "atlassian",
  "title": "Atlassian",
  "description": "Quick access to Jira and Confluence",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "author": "BSD-Yassin",
  "contributors": [],
  "pastContributors": [],
  "icon": "extension_icon.svg",
  "commands": [
    {
      "name": "atlassian-launcher",
      "title": "Atlassian Launcher",
      "description": "Open Jira/Confluence pages and searches",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "jiraBaseUrl",
      "title": "Jira Base URL",
      "description": "Example: https://yourorg.atlassian.net",
      "required": true,
      "type": "textfield"
    },
    {
      "name": "confluenceBaseUrl",
      "title": "Confluence Base URL",
      "description": "Example: https://yourorg.atlassian.net/wiki",
      "required": true,
      "type": "textfield"
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint"
  },
  "dependencies": {
    "@vicinae/api": "^0.20.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

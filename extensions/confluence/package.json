{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "confluence",
  "title": "Confluence",
  "description": "Search Confluence pages quickly",
  "categories": [
    "Productivity",
    "Documentation"
  ],
  "license": "MIT",
  "author": "BSD-Yassin",
  "contributors": [],
  "pastContributors": [],
  "icon": "extension_icon.svg",
  "commands": [
    {
      "name": "confluence-search",
      "title": "Search Confluence",
      "description": "Open Confluence search and home",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "confluenceBaseUrl",
      "title": "Confluence Base URL",
      "description": "Example: https://yourorg.atlassian.net/wiki",
      "required": false,
      "type": "textfield",
      "default": ""
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint"
  },
  "dependencies": {
    "@vicinae/api": "^0.20.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
